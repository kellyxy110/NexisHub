# Keep forms disabled until the webhook destination, legal review, and retention policy are approved.
NEXT_PUBLIC_FORMS_ENABLED=false

# HTTPS webhook that receives contact, Studio enquiry, and newsletter payloads.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=

# Optional consented analytics webhook.
ANALYTICS_WEBHOOK_URL=
ANALYTICS_WEBHOOK_TOKEN=

# Public canonical URL used by sitemap and robots output.
NEXT_PUBLIC_SITE_URL=https://nexishub.vercel.app

# Administration remains disabled until a real provider, adapter, auth layer, audit store,
# migrations, backup plan, and legal/privacy review are complete.
NEXIS_ADMIN_DATABASE_URL=
NEXIS_ADMIN_AUTH_SECRET=
NEXIS_ADMIN_AUDIT_STORE=

# Feature flags. All default to disabled. Enable only after authentication, migrations,
# security checks, and founder approval are recorded.
ADMIN_ENABLED=false
NEXIS_ADMIN_AUTH_READY=false
NRI_PUBLICATION_ADMIN_ENABLED=false
NRI_REVIEW_ADMIN_ENABLED=false
NRI_PILOT_ADMIN_ENABLED=false
NRI_CONSENT_ADMIN_ENABLED=false
STUDIO_OPERATIONS_ADMIN_ENABLED=false
ADMIN_EMAIL_SENDING_ENABLED=false
NEXIS_ADMIN_MIGRATIONS_READY=false
NEXIS_ADMIN_SECURITY_CHECKS_PASSED=false
NEXIS_ADMIN_FOUNDER_VERIFIED=false
